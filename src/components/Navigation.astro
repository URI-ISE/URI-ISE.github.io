---
// Primary navigation (desktop links + mobile menu). To add or reorder a page, edit `links` below.
import { cleanPath } from "../utils/paths";

const currentPath = cleanPath(Astro.url.pathname);

function isCurrent(path: string) {
  return currentPath === path;
}

const links = [
  { href: "/", label: "Home" },
  { href: "/research", label: "Research" },
  { href: "/industry4-0", label: "Industry 4.0" },
  { href: "/labs", label: "Labs" },
  { href: "/people", label: "People" },
  { href: "/contact", label: "Contact" },
];
---
<nav aria-label="Primary">
  <!-- Desktop: inline links -->
  <ul class="nav-links nav-inline">
    {links.map((link) => (
      <li>
        <a
          class={isCurrent(link.href) ? "nav-highlight" : ""}
          aria-current={isCurrent(link.href) ? "page" : undefined}
          href={link.href}
        >{link.label}</a>
      </li>
    ))}
  </ul>
  <!-- Mobile: CSS-only disclosure menu -->
  <details class="nav-menu">
    <summary aria-label="Open navigation menu">Menu</summary>
    <ul class="nav-links">
      {links.map((link) => (
        <li>
          <a
            class={isCurrent(link.href) ? "nav-highlight" : ""}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            href={link.href}
          >{link.label}</a>
        </li>
      ))}
    </ul>
  </details>
</nav>
