---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { cleanPath } from "../utils/paths";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Keep this page out of search results (used by the 404 page). */
  noindex?: boolean;
}

const {
  title = "URI Industrial & Systems Engineering",
  description = "The URI ISE Group develops optimization algorithms, machine-learning models, digital-twin simulations, and data-driven pipelines.",
  image = "/assets/og-default.jpg",
  noindex = false,
} = Astro.props;

const pagePath = cleanPath(Astro.url.pathname);
const canonicalURL = new URL(pagePath, Astro.site);
const imageURL = new URL(image, Astro.site);

// Structured data so search engines know who runs the site (home page only).
const organizationLd = {
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  name: "URI Industrial & Systems Engineering Group",
  alternateName: "URI ISE Group",
  url: "https://www.iseuri.org/",
  description,
  email: "sodhi@uri.edu",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Fascitelli Center for Advanced Engineering, 2 East Alumni Avenue",
    addressLocality: "Kingston",
    addressRegion: "RI",
    postalCode: "02881",
    addressCountry: "US",
  },
  parentOrganization: {
    "@type": "CollegeOrUniversity",
    name: "University of Rhode Island",
    url: "https://www.uri.edu",
  },
};
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph tags for Social Proof/Sharing -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="URI Industrial & Systems Engineering" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {pagePath === "/" && <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />}
    <meta name="theme-color" content="#1d2733" />

    <ClientRouter />
    
    <script is:inline>
      // Run theme initialization safely
      const initTheme = () => {
        var t = localStorage.getItem("uri-ise-theme") || "system";
        var dark = t === "dark" || (t === "system" && matchMedia("(prefers-color-scheme:dark)").matches);
        document.documentElement.setAttribute("data-theme", dark ? "dark" : "light");
      };
      
      initTheme();
      document.addEventListener('astro:after-swap', initTheme);
    </script>
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    
    <Header />

    <main id="main">
        <slot />
    </main>

    <Footer />

    <script>
        // Main client-side script wrapper
        // Handled via Astro page loads
        document.addEventListener('astro:page-load', () => {
            const themeBtn = document.getElementById('theme-toggle-btn');
            if(themeBtn) {
              themeBtn.addEventListener('click', () => {
                  let current = document.documentElement.getAttribute('data-theme');
                  let next = current === 'dark' ? 'light' : 'dark';
                  document.documentElement.setAttribute('data-theme', next);
                  localStorage.setItem('uri-ise-theme', next);
              });
            }

            // Unregister any service worker left over from the site's previous PWA setup
            if ("serviceWorker" in navigator) {
                navigator.serviceWorker.getRegistrations()
                    .then((regs) => regs.forEach((reg) => reg.unregister()))
                    .catch(() => {});
            }
        });
    </script>
</body>
</html>
