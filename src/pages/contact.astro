---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="URI ISE | Contact"
  description="Contact the URI Industrial & Systems Engineering Group about research partnerships, the Industry 4.0 Graduate Certificate, or joining the lab."
>
  <section class="page-header section-compact">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="tagline">Partner with the URI Industrial & Systems Engineering Group</p>
    </div>
  </section>

  <section class="section section-compact">
    <div class="container">
      <div class="contact-layout">

        <article class="contact-card">
          <h3>Send a Message</h3>
          <p>
            Interested in research collaboration, the Industry 4.0 Certificate, or learning more about our lab? Reach out.
          </p>
          <form id="contact-form">
            <label for="name" class="visually-hidden">Name</label>
            <input type="text" id="name" name="name" placeholder="Your Name" required />

            <label for="email" class="visually-hidden">Email</label>
            <input type="email" id="email" name="email" placeholder="Your Email Address" required />

            <label for="subject" class="visually-hidden">Subject</label>
            <select id="subject" name="subject" required>
              <option value="" disabled selected>Topic of Inquiry</option>
              <option value="research">Research Partnerships</option>
              <option value="certificate">Industry 4.0 Certificate</option>
              <option value="prospective-student">Prospective Student Inquiry</option>
              <option value="other">Other</option>
            </select>

            <label for="message" class="visually-hidden">Message</label>
            <textarea id="message" name="message" placeholder="How can we help you?" required></textarea>

            <button type="submit" class="button primary">Compose Email</button>
          </form>
          <p>
            Submitting opens your email client with the message pre-filled for sodhi@uri.edu —
            nothing is sent until you press send there.
          </p>
        </article>

        <article class="contact-card">
          <h3>Direct Contact</h3>
          <div class="contact-detail">
            <span class="contact-detail-label">Lab Director</span>
            <p>Dr. Manbir Sodhi</p>
            <a href="mailto:sodhi@uri.edu">sodhi@uri.edu</a>
          </div>
          <div class="contact-detail">
            <span class="contact-detail-label">Department</span>
            <a href="https://web.uri.edu/mcise/" target="_blank" rel="noopener noreferrer">Mechanical, Industrial &amp; Systems Engineering</a>
          </div>
          <div class="contact-detail">
            <span class="contact-detail-label">Location</span>
            <p>Fascitelli Center for Advanced Engineering (FCAE) 180A<br />Kingston, RI 02881</p>
            <a href="https://web.uri.edu/engineering/about/facilities/" target="_blank" rel="noopener">View campus facilities</a>
          </div>
        </article>

      </div>
    </div>
  </section>

  <script is:inline>
    const contactForm = document.getElementById("contact-form");

    if (contactForm) {
      contactForm.addEventListener("submit", (event) => {
        event.preventDefault();

        const name = document.getElementById("name")?.value?.trim() || "";
        const email = document.getElementById("email")?.value?.trim() || "";
        const topic = document.getElementById("subject")?.value || "other";
        const message = document.getElementById("message")?.value?.trim() || "";

        const topicMap = {
          research: "Research Partnerships",
          certificate: "Industry 4.0 Certificate",
          "prospective-student": "Prospective Student Inquiry",
          other: "Other"
        };

        const topicExtension = topicMap[topic] || "Other";
        const subject = `ISEURI Forward: ${topicExtension}`;
        const body = [
          `Name: ${name}`,
          `Email: ${email}`,
          `Topic: ${topicExtension}`,
          "",
          "Message:",
          message
        ].join("\n");

        window.location.href = `mailto:sodhi@uri.edu?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    }
  </script>
</BaseLayout>
