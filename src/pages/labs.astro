---
/*
 * Labs page — the four lab spaces are written inline below.
 * Photos live in src/assets/photos/ and are imported at the top of this file.
 */
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import capstonePhoto from "../assets/photos/capstone-demo-day.jpg";
import vehicleLabPhoto from "../assets/photos/vehicle-tracking-lab.jpeg";
import gradLoungePhoto from "../assets/photos/grad-lounge.jpeg";
import supportRoomPhoto from "../assets/photos/lab-support-room.jpeg";
---

<BaseLayout
  title="URI ISE | Labs"
  description="The physical spaces of the URI ISE Group on the Kingston campus: the Industry 4.0 capstone testbed, vision and tracking lab, graduate lounge, and lab support room."
>
  <section class="page-header section-compact">
    <div class="container">
      <p class="tagline">Physical spaces across the URI Kingston campus</p>
      <h1>Labs</h1>
      <p>
        The lab works across multiple spaces, from the main Industry 4.0 testbed to supporting rooms for visualization, fabrication, and student collaboration.
      </p>
    </div>
  </section>

  <section class="section section-compact">
    <div class="container">
      <div class="section-header">
        <h2>Lab Spaces</h2>
        <p>Where the work happens.</p>
      </div>
      <div class="lab-rooms">
        <article class="lab-room">
          <Image class="lab-room-img" src={capstonePhoto} alt="Students gathered around testbed equipment during a demo day in the capstone room" width={1200} widths={[480, 800, 1200]} sizes="(min-width: 1120px) 560px, (min-width: 700px) 50vw, 100vw" loading="eager" />
          <h3>Capstone Room</h3>
          <p class="lab-meta">FCAE 180A · Kingston, RI 02881</p>
          <p>Primary Industry 4.0 testbed for capstone projects and research, featuring collaborative robotics, integrated CNC capabilities, and dynamic automation.</p>
        </article>
        <article class="lab-room">
          <Image class="lab-room-img" style="object-position: center 45%;" src={vehicleLabPhoto} alt="Open garage door of the Driver and Vehicle Tracking Research Laboratory, showing a CNC machine and workbenches inside" width={1200} widths={[480, 800, 1200]} sizes="(min-width: 1120px) 560px, (min-width: 700px) 50vw, 100vw" />
          <h3>Vehicular Vision &amp; Tracking Lab</h3>
          <p class="lab-meta">KIRK Resources · Kingston, RI 02881</p>
          <p>Houses vision-focused research alongside higher-powered laser cutting and 3-D printing resources used across multiple lab projects.</p>
        </article>
        <article class="lab-room">
          <Image class="lab-room-img" src={gradLoungePhoto} alt="Graduate students working at cubicle workstations in the sunlit FCAE graduate lounge" width={1200} widths={[480, 800, 1200]} sizes="(min-width: 1120px) 560px, (min-width: 700px) 50vw, 100vw" />
          <h3>Graduate Lounge</h3>
          <p class="lab-meta">FCAE, Floor 2 · Kingston, RI 02881</p>
          <p>Collaborative workspace for graduate students — writing, analysis, and project coordination.</p>
        </article>
        <article class="lab-room">
          <Image class="lab-room-img" style="object-position: center 62%;" src={supportRoomPhoto} alt="Lab support room with a large printed grid table for robot testing, workstations, and a whiteboard" width={1200} widths={[480, 800, 1200]} sizes="(min-width: 1120px) 560px, (min-width: 700px) 50vw, 100vw" />
          <h3>Lab Support Room</h3>
          <p class="lab-meta">FCAE · Kingston, RI 02881</p>
          <p>Additional workspace and storage supporting ongoing testbed research and equipment maintenance.</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
