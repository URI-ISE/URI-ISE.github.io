---
/*
 * People page — built from one Markdown file per member in src/content/people/.
 * To add or edit a member, edit their file (see CONTRIBUTING.md); section headings live in src/data/tags.ts.
 * Cards are shuffled into a random order within each section on every page load
 * (alphabetical by last name when JavaScript is off).
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Shuffle from "../components/Shuffle.astro";
import { SECTIONS, SECTION_HEADINGS } from "../data/tags";

const people = await getCollection("people", ({ data }) => !(import.meta.env.PROD && data.draft));

const nameWords = (name: string) => name.replace(/^Dr\.?\s+/, "").split(/\s+/);
const sortKey = (p: (typeof people)[number]) =>
  (p.data.sortName ?? nameWords(p.data.name).at(-1) ?? p.data.name).toLowerCase();
const initials = (p: (typeof people)[number]) => {
  const words = nameWords(p.data.name);
  const last = p.data.sortName?.split(/\s+/)[0] ?? words.at(-1) ?? "";
  return `${words[0]?.[0] ?? ""}${last[0] ?? ""}`.toUpperCase();
};

const sections = SECTIONS.map((section) => ({
  heading: SECTION_HEADINGS[section],
  large: section === "advisor",
  members: people
    .filter((p) => p.data.section === section)
    .sort((a, b) => sortKey(a).localeCompare(sortKey(b))),
})).filter((section) => section.members.length > 0);
---

<BaseLayout
  title="URI ISE | People"
  description="The URI ISE Group: faculty, post-doctoral, doctoral, master's, and undergraduate researchers led by Dr. Manbir Sodhi."
>
  <section class="page-header section-compact">
    <div class="container">
      <h1>People</h1>
      <p class="tagline">A multi-level team focused on industrial systems engineering research and practical applications.</p>
    </div>
  </section>

  <section class="section section-compact">
    <div class="container profile-grid">
      {sections.map((section) => (
        <div class="profile-section">
          <h2>{section.heading}</h2>
          <div class={section.members.length > 1 ? "card-grid" : ""} data-shuffle>
            {section.members.map((member) => (
              <article class={`profile-card${section.large ? " large" : ""}`} id={member.id}>
                {member.data.photo ? (
                  <div class="avatar">
                    <Image
                      src={member.data.photo}
                      alt={`Portrait of ${member.data.name}`}
                      width={144}
                      height={144}
                      fit="cover"
                      position="attention"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="avatar avatar-initials" aria-hidden="true">{initials(member)}</div>
                )}
                <div class="profile-meta">
                  <strong>{member.data.name}</strong>
                  {member.data.role && <span class="profile-role">{member.data.role}</span>}
                  {member.data.email && <a href={`mailto:${member.data.email}`}>{member.data.email}</a>}
                  {member.data.bio && <p>{member.data.bio}</p>}
                  {member.data.links.length > 0 && (
                    <div class="profile-links">
                      {member.data.links.map((link) => (
                        <a href={link.href}>{link.label}</a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
    <Shuffle />
  </section>
</BaseLayout>
