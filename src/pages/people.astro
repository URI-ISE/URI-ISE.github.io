---

<BaseLayout title="URI ISE | People">
  <section class="page-header section-compact">
    <div class="container">
      <h1>People</h1>
      <p class="tagline">A multi-level team focused on industrial systems engineering research and practical applications.</p>
    </div>
  </section>

  <section class="section section-compact">
    <div class="container profile-grid">
      {sections.map((section) => (
        <div class="profile-section">
          <h2>{section.heading}</h2>
          <div class={section.members.length > 1 ? "card-grid" : ""}>
            {section.members.map((member) => (
              <article class={`profile-card${section.large ? " large" : ""}`}>
                <div class="avatar"><img src={member.photo} alt={member.name} /></div>
                <div class="profile-meta">
                  <strong>{member.name}</strong>
                  {member.role && <span class="profile-role">{member.role}</span>}
                  <a href={`mailto:${member.email}`}>{member.email}</a>
                  <p>{member.bio}</p>
                  {member.links && member.links.length > 0 && (
                    <div class="profile-links">
                      {member.links.map((link) => (
                        <a href={link.href}>[ {link.label} ]</a>
                      ))}
                    </div>
                  )}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
