---
/*
 * Research page — a compact box of the six research threads, then the project write-ups with a tag filter.
 * Projects appear in a random order on every visit (alphabetical by title without JavaScript).
 * To edit:
 *   - Thread names/summaries and the approved tag list: src/data/tags.ts
 *   - Projects: one Markdown file each in src/content/projects/ (see CONTRIBUTING.md)
 * The old /projects URL redirects here (astro.config.mjs).
 */
import { getCollection, getEntries, getEntry, render } from "astro:content";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Shuffle from "../components/Shuffle.astro";
import { THREADS, isThread, tagLabel } from "../data/tags";

const projects = (
  await getCollection("projects", ({ data }) => !(import.meta.env.PROD && data.draft))
).sort((a, b) => a.data.title.localeCompare(b.data.title));

const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const noteHtml = (s: string) => escapeHtml(s).replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");

const entries = await Promise.all(
  projects.map(async (project) => {
    const researcher = project.data.researcher ? await getEntry(project.data.researcher) : undefined;
    const supporting = await getEntries(project.data.supporting);
    if ((project.data.researcher && !researcher) || supporting.some((person) => !person)) {
      throw new Error(`Unknown person in "researcher" or "supporting" of src/content/projects/${project.id}.md — use file names from src/content/people/ (without .md).`);
    }
    const isVisible = (person: (typeof supporting)[number]) => !!person && !(import.meta.env.PROD && person.data.draft);
    const media = await Promise.all(
      project.data.media.map(async (item) => ({
        ...item,
        posterSrc: item.poster ? (await getImage({ src: item.poster, width: 960, format: "jpg" })).src : undefined,
      })),
    );
    const { Content } = await render(project);
    return {
      project,
      Content,
      media,
      researcher: isVisible(researcher) ? researcher : undefined,
      supporting: supporting.filter(isVisible),
      threadTags: project.data.tags.filter(isThread),
      otherTags: project.data.tags.filter((tag) => !isThread(tag)),
    };
  }),
);

const countFor = (slug: string) => projects.filter((p) => (p.data.tags as string[]).includes(slug)).length;
---

<BaseLayout
  title="URI ISE | Research"
  description="Research at the URI ISE Group: six threads from digital twins to resilient cyber-physical systems, plus the lab-built projects behind them, filterable by topic."
>
  <section class="page-header section-compact">
    <div class="container">
      <p class="tagline">Algorithm to Action</p>
      <h1>Research</h1>
      <p>
        Working hardware and real experiments across six research threads — from digital twins to resilient
        cyber-physical systems — many growing out of the <a href="/industry4-0#certificate">Industry 4.0 certificate</a>
        coursework. Filter the projects by thread or hashtag.
      </p>

      <div class="thread-box" id="threads">
        <h2>Research Threads</h2>
        <ul class="thread-list">
          {THREADS.map((thread) => {
            const count = countFor(thread.slug);
            return (
              <li id={thread.slug}>
                <h3>
                  {count > 0 ? (
                    <a href={`/research?tag=${thread.slug}#projects`} data-filter-tag={thread.slug}>{thread.label}</a>
                  ) : (
                    thread.label
                  )}
                </h3>
                <p>{thread.summary}</p>
                <span class="thread-count">{count === 0 ? "No projects yet" : count === 1 ? "1 project" : `${count} projects`}</span>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-compact" id="projects">
    <div class="container">
      <div class="section-header">
        <h2>Projects</h2>
        <p>Applied systems built and studied in the lab.</p>
      </div>

      <div class="tag-filter" data-filter role="group" aria-label="Filter projects by research thread" hidden>
        <button type="button" class="tag-chip" data-filter-tag="" aria-pressed="true">
          All <span class="tag-count">{projects.length}</span>
        </button>
        {THREADS.map((thread) => (
          <button type="button" class="tag-chip" data-filter-tag={thread.slug} aria-pressed="false" disabled={countFor(thread.slug) === 0}>
            {thread.label} <span class="tag-count">{countFor(thread.slug)}</span>
          </button>
        ))}
        <button type="button" class="tag-chip" data-filter-extra aria-pressed="true" hidden></button>
      </div>
      <p class="filter-status" data-filter-status aria-live="polite"></p>

      <div class="project-list" data-shuffle>
      {entries.map(({ project, Content, media, researcher, supporting, threadTags, otherTags }) => (
        <article class="project-entry" id={project.id} data-tags={project.data.tags.join(" ")}>
          <span class="project-kicker">{project.data.kicker}</span>
          <h2>{project.data.title}</h2>
          {researcher && (
            <p class="project-researcher">
              Primary researcher: <a href={`/people#${researcher.id}`}>{researcher.data.name}</a>
              {supporting.length > 0 && (
                <>
                  <span class="project-researcher-sep" aria-hidden="true"> · </span>
                  Supporting:{" "}
                  {supporting.map((person, i) => (
                    <>{i > 0 && ", "}<a href={`/people#${person!.id}`}>{person!.data.name}</a></>
                  ))}
                </>
              )}
            </p>
          )}
          <Content />
          {project.data.note && <p class="project-note" set:html={noteHtml(project.data.note)} />}
          <ul class="tag-list" aria-label="Tags">
            {[...threadTags, ...otherTags].map((tag) => (
              <li>
                <a class={isThread(tag) ? "tag tag-thread" : "tag"} href={`/research?tag=${tag}#projects`} data-filter-tag={tag}>
                  {tagLabel(tag)}
                </a>
              </li>
            ))}
          </ul>
          {media.length > 0 && (
            <div class="project-media">
              {media.map((item) => (
                <figure class={item.portrait ? "project-figure project-figure-portrait" : "project-figure"}>
                  {item.image ? (
                    <Image
                      src={item.image}
                      alt={item.alt}
                      width={1200}
                      widths={[480, 800, 1200]}
                      sizes="(min-width: 1120px) 360px, (min-width: 700px) 50vw, 100vw"
                      quality={70}
                      loading="lazy"
                    />
                  ) : (
                    <video
                      controls
                      muted
                      playsinline
                      preload="none"
                      poster={item.posterSrc}
                      width={item.poster?.width}
                      height={item.poster?.height}
                    >
                      <source src={item.video} type="video/mp4" />
                    </video>
                  )}
                  <figcaption>{item.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}
        </article>
      ))}
      </div>
      <Shuffle />

      <p class="filter-empty" data-filter-empty hidden>
        No project write-ups carry this tag yet. <a href="/research#projects" data-filter-tag="">Show all projects</a>.
      </p>
    </div>
  </section>

</BaseLayout>

<script>
  // Progressive enhancement: without JS every project shows and tag links just reload the page.
  document.addEventListener("astro:page-load", () => {
    const bar = document.querySelector<HTMLElement>("[data-filter]");
    if (!bar) return;
    bar.hidden = false;

    const projects = [...document.querySelectorAll<HTMLElement>(".project-entry[data-tags]")];
    const chips = [...bar.querySelectorAll<HTMLButtonElement>(".tag-chip[data-filter-tag]")];
    const extraChip = bar.querySelector<HTMLButtonElement>("[data-filter-extra]")!;
    const status = document.querySelector<HTMLElement>("[data-filter-status]")!;
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]")!;
    const section = document.getElementById("projects")!;
    const known = new Set(projects.flatMap((p) => p.dataset.tags!.split(" ")));
    chips.forEach((chip) => known.add(chip.dataset.filterTag!));

    const labelFor = (tag: string) =>
      chips.find((c) => c.dataset.filterTag === tag)?.firstChild?.textContent?.trim() ?? `#${tag}`;

    function apply(requested: string) {
      const tag = known.has(requested) ? requested : "";
      let shown = 0;
      for (const project of projects) {
        const match = !tag || project.dataset.tags!.split(" ").includes(tag);
        project.hidden = !match;
        if (match) shown++;
      }
      chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.filterTag === tag)));
      const isThreadChip = chips.some((c) => c.dataset.filterTag === tag);
      extraChip.hidden = !tag || isThreadChip;
      extraChip.textContent = `#${tag} ×`;
      extraChip.setAttribute("aria-label", `#${tag} — clear filter`);
      status.textContent = tag
        ? `Showing ${shown} of ${projects.length} projects tagged ${labelFor(tag)}.`
        : "";
      empty.hidden = shown > 0;

      const url = new URL(location.href);
      if (tag) url.searchParams.set("tag", tag);
      else url.searchParams.delete("tag");
      // Keep history.state: Astro's ClientRouter ignores entries whose state is null.
      history.replaceState(history.state, "", url);
    }

    document.querySelectorAll<HTMLElement>("[data-filter-tag]").forEach((el) => {
      el.addEventListener("click", (event) => {
        event.preventDefault();
        apply(el.dataset.filterTag!);
        if (!bar.contains(el)) section.scrollIntoView({ block: "start" });
      });
    });
    extraChip.addEventListener("click", () => apply(""));

    apply(new URL(location.href).searchParams.get("tag") ?? "");
  });
</script>
